<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ title | default("NexaDev") }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/3.4.1/tailwind.min.js"></script>
  </head>
  <body class="bg-white text-slate-900 antialiased font-sans">
    <header class="bg-white border-b py-4">
      <div class="max-w-4xl mx-auto px-4">
        <a href="/" class="font-bold text-lg">NexaDev</a>
      </div>
    </header>
    <main id="main" class="max-w-4xl mx-auto px-4 py-10">
      {{ content | safe }}
    </main>
    <footer class="max-w-4xl mx-auto px-4 py-6 text-sm text-slate-500">
      <p>© {{ "now" | date("yyyy") }} NexaDev. Tous droits réservés.</p>
    </footer>
  </body>
</html>